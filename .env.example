# ==============================================================================
# LLM API Keys and Model Configurations
# ==============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face Token (for downloading or validating model artifacts)
HF_TOKEN=

# ==============================================================================
# Supabase Database and Storage Configurations
# ==============================================================================
# Connection URL for FastAPI synchronous ORM operations (psycopg2)
SUPABASE_DB_URL=

# Asynchronous connection URL dedicated to Chainlit session persistence (asyncpg)
CHAINLIT_DATABASE_URL=

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=documents

# ==============================================================================
# Authentication and Session Security Settings
# ==============================================================================
CHAINLIT_AUTH_SECRET=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
CORS_ORIGINS=http://localhost:5173

# ==============================================================================
# N8N Workflow Integrations
# ==============================================================================
N8N_SHARED_SECRET=
N8N_WEBHOOK_URL=

# ==============================================================================
# LiteLLM Proxy and Swappable Model Configuration
# ==============================================================================
LITELLM_MASTER_KEY=
LITELLM_API_BASE=http://alfa_focus_litellm:4000/
LITELLM_API_KEY=
LITELLM_MODEL=gemini/gemini-2-5-flash
LITELLM_FALLBACK_MODELS=openrouter-free
LITELLM_DATABASE_URL=

# RAG chunking
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150