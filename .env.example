# ENV VARIABLES REQUIRED LISTED HERE

# LiteLLM Proxy / Unified LLM Interface (Recommended)
# When running LiteLLM Proxy (e.g. `docker compose up litellm` or `litellm --config litellm/config.yaml`):
LITELLM_MASTER_KEY=sk-master-key-here
LITELLM_API_BASE=http://alfa_focus_litellm:4000
LITELLM_API_KEY=sk-master-key-here
LITELLM_MODEL=gemini/gemini-2-5-flash
LITELLM_FALLBACK_MODELS=openrouter-free
LITELLM_DATABASE_URL=

# Provider keys (passed to LiteLLM Proxy or used for direct provider calls)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b

HF_TOKEN=

SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

N8N_WEBHOOK_URL=

# chainlit create-secret
CHAINLIT_AUTH_SECRET=

# FastAPI session cookie signing key (required for /api/auth/*). No default.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
CORS_ORIGINS=http://localhost:5173

